@model IEnumerable<ProyectoFinal_FernandezCarlos.Models.Docente>

@{
    ViewData["Title"] = "Gestión de profesores";
    int page = ViewBag.Page is int p ? p : 1;
    int totalPages = ViewBag.TotalPages is int tp ? tp : 1;
}

<partial name="_BackButton" />

<h1>Gestión de profesores</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<a asp-action="Create" class="btn-sistema mb-3">Agregar</a>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No hay profesores registrados.
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var docente in Model)
            {
                <tr>
                    <td>@docente.Nombre</td>
                    <td>@docente.Correo</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@docente.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Delete" asp-route-id="@docente.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (totalPages > 1)
{
    <div class="mt-4 text-center">
        @for (int i = 1; i <= totalPages; i++)
        {
            <a asp-action="Inicio"
                   asp-route-page="@i"
                   class="btn-sistema btn-paginacion @(i == page ? "btn-paginacion-activa" : "")">
                @i
            </a>
        }
    </div>
}