@model ProyectoFinal_FernandezCarlos.Models.Docente

@{
    ViewData["Title"] = "Editar profesor";
}

<h1>Editar profesor</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Correo" class="form-label"></label>
        <input asp-for="Correo" class="form-control" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn-sistema">Guardar</button>
        <a asp-action="Inicio" class="btn-sistema">Volver</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}