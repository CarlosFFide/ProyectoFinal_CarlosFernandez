@model IEnumerable<ProyectoFinal_FernandezCarlos.Models.Curso>

@{
    ViewData["Title"] = "Cursos disponibles";
    var cursosMatriculados = ViewBag.CursosMatriculados as List<int> ?? new List<int>();
    int page = ViewBag.Page is int p ? p : 1;
    int totalPages = ViewBag.TotalPages is int tp ? tp : 1;
}

<partial name="_BackButton" />

<h1>Cursos disponibles</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        No hay cursos disponibles para la carrera seleccionada.
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Créditos</th>
                <th>Docente</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var curso in Model)
            {
                var yaMatriculado = cursosMatriculados.Contains(curso.Id);

                <tr>
                    <td>@curso.Codigo</td>
                    <td>@curso.Nombre</td>
                    <td>@curso.Creditos</td>
                    <td>
                        @if (curso.Docente != null)
                        {
                            @curso.Docente.Nombre
                        }
                        else
                        {
                            <span>Sin docente</span>
                        }
                    </td>
                    <td>
                        @if (yaMatriculado)
                        {
                            <button type="button" class="btn-sistema" disabled>
                                Matriculado
                            </button>
                        }
                        else
                        {
                            <form asp-action="Matricular" method="post">
                                <input type="hidden" name="cursoId" value="@curso.Id" />
                                <button type="submit" class="btn-sistema">
                                    Matricular
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (totalPages > 1)
{
    <div class="mt-4 text-center">
        @for (int i = 1; i <= totalPages; i++)
        {
            <a asp-action="CursosDisponibles"
                   asp-route-page="@i"
                   class="btn-sistema btn-paginacion @(i == page ? "btn-paginacion-activa" : "")">
                @i
            </a>
        }
    </div>
}