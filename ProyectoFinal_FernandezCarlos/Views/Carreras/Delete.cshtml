@model ProyectoFinal_FernandezCarlos.Models.Carrera

@{
    ViewData["Title"] = "Eliminar carrera";
}

<h1>Eliminar carrera</h1>

<p class="text-danger">¿Está seguro que desea eliminar esta carrera?</p>

<dl class="row">
    <dt class="col-sm-2">Código</dt>
    <dd class="col-sm-10">@Model.Codigo</dd>
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Inicio" class="btn btn-secondary">Cancelar</a>
</form>
