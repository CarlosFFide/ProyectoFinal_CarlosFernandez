@using Microsoft.AspNetCore.Identity
@using ProyectoFinal_FernandezCarlos.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <form class="logout-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Inicio", "Home", new { area = "" })">
        <button type="submit" class="session-button session-logout">
            Cerrar sesión
        </button>
    </form>
}