<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Matrícula</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProyectoFinal_FernandezCarlos.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <header class="app-header">
            <div class="app-header-inner">
                <div class="app-title-area">
                    @if (User.IsInRole("Administrador"))
                    {
                        <a class="app-title" asp-area="" asp-controller="Admin" asp-action="Inicio">
                            Panel Administrador
                        </a>
                    }
                    else if (User.IsInRole("Estudiante"))
                    {
                        <a class="app-title" asp-area="" asp-controller="Estudiante" asp-action="Inicio">
                            Panel de Estudiante
                        </a>
                    }
                    else
                    {
                        <a class="app-title" asp-area="" asp-controller="Home" asp-action="Inicio">
                            Sistema de Matrícula
                        </a>
                    }
                </div>

                <nav class="app-nav">
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-area="" asp-controller="Admin" asp-action="Inicio">Inicio</a>
                        <a asp-area="" asp-controller="Carreras" asp-action="Inicio">Carreras</a>
                        <a asp-area="" asp-controller="Cursos" asp-action="Inicio">Cursos</a>
                        <a asp-area="" asp-controller="Docentes" asp-action="Inicio">Docentes</a>
                    }
                    else if (User.IsInRole("Estudiante"))
                    {
                        <a asp-area="" asp-controller="Estudiante" asp-action="Inicio">Inicio</a>
                        <a asp-area="" asp-controller="Estudiante" asp-action="Carreras">Carreras</a>
                        <a asp-area="" asp-controller="Estudiante" asp-action="CursosDisponibles">Matricular cursos</a>
                        <a asp-area="" asp-controller="Estudiante" asp-action="MisCursos">Mis cursos</a>
                    }
                    else
                    {
                        <a asp-area="" asp-controller="Home" asp-action="Inicio">Inicio</a>
                    }
                </nav>

                <div class="app-session">
                    @if (!User.Identity?.IsAuthenticated ?? true)
                    {
                        <a class="session-button session-login" asp-area="Identity" asp-page="/Account/Login">
                            Iniciar sesión
                        </a>
                    }
                    else
                    {
                        <partial name="_LoginPartial" />
                    }
                </div>
            </div>
        </header>

        <main class="app-main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>