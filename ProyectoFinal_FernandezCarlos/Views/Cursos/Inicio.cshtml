@model IEnumerable<ProyectoFinal_FernandezCarlos.Models.Curso>

@{
    ViewData["Title"] = "Cursos";
    string search = ViewBag.Search as string ?? string.Empty;
    int? creditos = ViewBag.Creditos as int?;
}

<partial name="_BackButton" />

<h1>Cursos</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<a asp-action="Create" class="btn-sistema mb-3">Agregar Curso</a>

<div class="row mb-3">
    <div class="col-md-8 mb-2">
        <label for="buscarCursos" class="form-label">Buscar curso</label>
        <input type="text"
               id="buscarCursos"
               class="form-control"
               value="@search"
               placeholder="Código, nombre, carrera o docente" />
    </div>

    <div class="col-md-4 mb-2">
        <label for="creditosCursos" class="form-label">Créditos</label>
        <input type="number"
               id="creditosCursos"
               class="form-control"
               min="1"
               max="10"
               value="@(creditos?.ToString() ?? string.Empty)"
               placeholder="Todos" />
    </div>
</div>

<div id="tablaCursos">
    <partial name="_CursosTabla" model="Model" />
</div>

@section Scripts {
    <script>
        configurarTablaCursosAjax();
    </script>
}