@model ProyectoFinal_FernandezCarlos.Models.Curso

@{
    ViewData["Title"] = "Editar curso";
}

<h1>Editar curso</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Codigo" class="form-label"></label>
        <input asp-for="Codigo" class="form-control" />
        <span asp-validation-for="Codigo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Creditos" class="form-label"></label>
        <input asp-for="Creditos" class="form-control" />
        <span asp-validation-for="Creditos" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CarreraId" class="form-label">Carrera</label>
        <select asp-for="CarreraId" asp-items="ViewBag.CarreraId" class="form-select">
            <option value="">-- Seleccione una carrera --</option>
        </select>
        <span asp-validation-for="CarreraId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DocenteId" class="form-label">Docente</label>
        <select asp-for="DocenteId" asp-items="ViewBag.DocenteId" class="form-select">
            <option value="">-- Sin docente asignado --</option>
        </select>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn-sistema">Guardar</button>
        <a asp-action="Inicio" class="btn-sistema">Volver</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}