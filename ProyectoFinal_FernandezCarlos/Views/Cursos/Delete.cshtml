@model ProyectoFinal_FernandezCarlos.Models.Curso

@{
    ViewData["Title"] = "Eliminar curso";
}

<h1>Eliminar curso</h1>

<p class="text-danger">¿Está seguro que desea eliminar este curso?</p>

<dl class="row">
    <dt class="col-sm-2">Código</dt>
    <dd class="col-sm-10">@Model.Codigo</dd>
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>
    <dt class="col-sm-2">Créditos</dt>
    <dd class="col-sm-10">@Model.Creditos</dd>
    <dt class="col-sm-2">Carrera</dt>
    <dd class="col-sm-10">@Model.Carrera?.Nombre</dd>
    <dt class="col-sm-2">Docente</dt>
    <dd class="col-sm-10">@Model.Docente?.Nombre</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Inicio" class="btn btn-secondary">Cancelar</a>
</form>
